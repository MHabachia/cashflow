# Vorlage für .env – alle Variablen sind in docs/configuration.md beschrieben.

# Öffentliche Adresse der App (z. B. https://cashflow.example.org)
APP_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Secret für Sitzungen, mindestens 32 Zeichen: openssl rand -base64 32
# Im Docker-Container leer lassen: Dann wird beim ersten Start eines erzeugt
# und in /data/.auth-secret gespeichert. Für `npm run start` außerhalb von
# Docker muss es gesetzt sein.
AUTH_SECRET=

# Empfohlen: eigener Schlüssel für die Bank-Tokens (openssl rand -base64 32)
# TOKEN_ENCRYPTION_KEY=
# Empfohlen: automatische Sicherungen verschlüsseln – Schlüssel sicher aufbewahren!
# BACKUP_ENCRYPTION_KEY=
# Nur für einen externen Cron auf POST /api/cron/bank-sync (mind. 32 Zeichen)
# CRON_SECRET=

# Client-IP für das Rate-Limit (Anmeldung, 2FA, Passwort-Reset)
# Ohne Angabe gilt x-forwarded-for,x-real-ip. Hinter Cloudflare z. B.:
# IP_ADDRESS_HEADERS=cf-connecting-ip
# Direkter Zugriff ohne Reverse Proxy (BIND_ADDRESS=0.0.0.0): Zeile ohne Wert
# setzen (IP_ADDRESS_HEADERS=), damit sich keine IP über Header vortäuschen lässt.
# IPs/CIDR des eigenen Reverse Proxys für mehrteilige X-Forwarded-For-Ketten
# TRUSTED_PROXIES=

# Nur docker-compose.yml: Port-Bindung und Image-Version
# BIND_ADDRESS=127.0.0.1
# CASHFLOW_VERSION=1.3.0

# Lokale Entwicklung außerhalb von Docker
# DATABASE_PATH=./data/app.db
# UPLOADS_DIR=./data/uploads

# Kontakt für Push-Dienste (mailto: oder https:)
# VAPID_SUBJECT=mailto:admin@example.com
