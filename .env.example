# Datenbank & Uploads (in Docker: /data/app.db und /data/uploads)
DATABASE_PATH=./data/app.db
UPLOADS_DIR=./data/uploads

# Better Auth Konfiguration
# Generiere ein Secret mit: openssl rand -base64 32
BETTER_AUTH_SECRET=bitte-aendern-in-ein-sicheres-32-zeichen-secret-123456
AUTH_SECRET=bitte-aendern-in-ein-sicheres-32-zeichen-secret-123456

# Öffentliche URL der App (z. B. https://kosten.example.com oder http://localhost:3000)
BETTER_AUTH_URL=http://localhost:3000
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Eigener Schlüssel für die Verschlüsselung der Bank-Tokens (empfohlen, mind. 32 Zeichen)
# TOKEN_ENCRYPTION_KEY=
# Bearer-Token für POST /api/cron/bank-sync (mind. 32 Zeichen; ohne ist der Endpunkt aus)
# CRON_SECRET=

# Automatische Sicherungen verschlüsseln (empfohlen, mind. 32 Zeichen – Schlüssel sicher aufbewahren!)
# BACKUP_ENCRYPTION_KEY=
# Kontakt für Push-Dienste (mailto: oder https:)
# VAPID_SUBJECT=mailto:admin@example.com
